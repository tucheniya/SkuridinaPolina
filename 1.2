sub1 = input("Введите название первого предмета: ")
les1 = int(input("Количество занятий в неделю по первому предмету: "))
dlit1 = int(input("Длительность одного занятия (мин): "))

sub2 = input("Введите название второго предмета: ")
les2 = int(input("Количество занятий в неделю по второму предмету: "))
dlit2 = int(input("Длительность одного занятия (мин): "))

weektime = float(input("Введите доступное время на неделю (в часах):"))
time1min = les1 * dlit1
time2min = les2 * dlit2
totalmin = time1min + time2min
totalhours = totalmin / 60
hours = weektime - totalhours
fourweekshours = totalhours * 4
print()
print("==== Нагрузка ====")
print(sub1 + ":", time1min, "мин.")
print(sub2 + ":", time2min, "мин.")
print("Общая нагрузка в минутах:", totalmin, "мин.")
print(f"Общая нагрузка в часах: {totalhours:.2f} ч.")
print(f"Остаток свободного времени: {hours:.2f} ч.")
print(f"Нагрузка за 4 недели: {fourweekshours:.2f} ч.")
